---
/**
 * DYNAMIC HEADER COMPONENT
 * ========================
 *
 * This header uses data-driven navigation from src/data/navData.json.
 *
 * Features:
 * - Automatically generates nav items from navData.json
 * - Helper functions from utils.js for cleaner code (isCurrentPage, getDropdownId)
 *
 */

// Utils
import { Icon } from "astro-icon/components";
import { isCurrentPage, getDropdownId } from "@js/utils.js";

// Components
import DarkModeToggle from "@components/DarkModeToggle/DarkModeToggle.astro";

// Data
import navData from "@data/navData.json";
---

<!-- ============================================ -->
<!--                 Navigation                   -->
<!-- ============================================ -->
<header id="cs-navigation">
    <!--Nav Logo-->
    <a
    href="/"
    class="cs-logo"
    aria-label="Voltar para a página inicial da Empresa"
  >
    <img
      src="/images/logos/logo.png"
      alt=""
      width="1322"
      height="418"
      decoding="async"
    />
  </a>
    
    <!--Navigation List-->
    <nav class="cs-nav" aria-label="main navigation">
        <!--Mobile Nav Toggle-->
        <button class="cs-toggle" id="mobile-menu-toggle" aria-expanded="false" aria-controls="cs-ul-wrapper" aria-label="mobile menu toggle" aria-haspopup="menu">
            <span class="cs-box" aria-hidden="true">
                <span class="cs-line cs-line1"></span>
                <span class="cs-line cs-line2"></span>
                <span class="cs-line cs-line3"></span>
            </span>
        </button>
        <!-- We need a wrapper div so we can set a fixed height on the cs-ul in case the nav list gets too long from too many dropdowns being opened and needs to have an overflow scroll. This wrapper acts as the background so it can go the full height of the screen and not cut off any overflowing nav items while the cs-ul stops short of the bottom of the screen, which keeps all nav items in view no matter how mnay there are-->
        <div class="cs-ul-wrapper" id="cs-ul-wrapper">
            <ul class="cs-ul">
                {
                    navData.map((entry) => {
                        const hasChildren = entry.children?.length > 0;
                        const isEntryActive =
                            Astro.url.pathname === entry.url ||
                            entry.children?.some(
                                (child) => Astro.url.pathname === child.url,
                            );

                        return (
                            <li
                                class:list={[
                                    "cs-li",
                                    { "cs-dropdown": hasChildren },
                                ]}
                            >
                                {hasChildren ? (
                                    <>
                                        <button
                                            id={getDropdownId(entry.key)}
                                            type="button"
                                            class:list={[
                                                "cs-li-link cs-dropdown-toggle",
                                                { "cs-active": isEntryActive },
                                            ]}
                                            aria-expanded="false"
                                            aria-haspopup="menu"
                                        >
                                            {entry.key}
                                            <Icon
                                                name="mdi--caret"
                                                class="cs-drop-icon"
                                            />
                                        </button>
                                        <ul
                                            class="cs-drop-ul"
                                            aria-labelledby={getDropdownId(
                                                entry.key,
                                            )}
                                        >
                                            {entry.children.map((child) => (
                                                <li class="cs-drop-li">
                                                    <a
                                                        href={child.url}
                                                        class:list={[
                                                            "cs-li-link cs-drop-link",
                                                            {
                                                                "cs-active":
                                                                    Astro.url
                                                                        .pathname ===
                                                                    child.url,
                                                            },
                                                        ]}
                                                        aria-current={isCurrentPage(
                                                            Astro.url.pathname,
                                                            child.url,
                                                        )}
                                                    >
                                                        {child.key}
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </>
                                ) : (
                                    <a
                                        href={entry.url}
                                        class:list={[
                                            "cs-li-link",
                                            {
                                                "cs-active":
                                                    Astro.url.pathname ===
                                                    entry.url,
                                            },
                                        ]}
                                        aria-current={isCurrentPage(
                                            Astro.url.pathname,
                                            entry.url,
                                        )}
                                    >
                                        {entry.key}
                                    </a>
                                )}
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </nav>
    <a href="/contact/" class="cs-button-solid cs-nav-button">Orçamento</a>

</header>
                                
                                
                                
                                
                                
                                

<style lang="less">

/*-- -------------------------- -->
<---     Mobile Navigation      -->
<--- -------------------------- -*/
/* Mobile - 1023.5px */
@media only screen and (max-width: 1023.5px) {
  body.cs-open {
    overflow: hidden;
  }
  #cs-navigation {
    width: 100%;
    /* prevents padding and border from affecting height and width */
    box-sizing: border-box;
    padding: var(--space-sm, 0.75rem) var(--space-md, 1rem);
    background-color: var(--surfaceColor, #fff);
    box-shadow: var(--shadow-soft, rgba(149, 157, 165, 0.2) 0px 8px 24px);
    position: fixed;
    z-index: 100;
  }
  #cs-navigation:after {
    /* on hover green bar */
    content: "";
    width: 40%;
    max-width: 9.125rem;
    height: 100%;
    background: var(--primary);
    opacity: 1;
    display: block;
    position: absolute;
    top: 0;
    left: 0%;
    z-index: -1;
    transition:
      width 0.2s,
      max-width var(--transitionBase, 0.3s ease),
      background-color var(--transitionBase, 0.3s ease);
  }
  #cs-navigation:before {
    /* grey blurrd overlay */
    content: "";
    width: 100%;
    height: 0vh;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    display: block;
    position: absolute;
    top: 100%;
    right: 0;
    z-index: -11;
    transition:
      height var(--transitionSlow, 0.5s ease),
      opacity var(--transitionBase, 0.3s ease);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  #cs-navigation.cs-active:after {
    width: 100%;
    max-width: 100%;
    background-color: #484848;
  }
  #cs-navigation.cs-active:before {
    height: 150vh;
    opacity: 1;
  }
  #cs-navigation.cs-active .cs-ul-wrapper {
    opacity: 1;
    transform: scaleY(1);
    transition-delay: 0.2s;
  }
  #cs-navigation.cs-active .cs-li {
    opacity: 1;
    transform: translateY(0);
  }

  #cs-navigation .cs-logo {
    width: 40%;
    max-width: 9.125rem;
    height: 100%;
    /* prevents padding and border from affecting height and width */
    box-sizing: border-box;
    padding: 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
  }
  #cs-navigation .cs-logo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100%;
    /* ensures the image never overflows the container. It stays contained within it's width and height and expands to fill it then stops once it reaches an edge */
    object-fit: contain;
  }
  #cs-navigation .cs-toggle {
    /* 44px - 48px */
    width: clamp(2.75rem, 6vw, 3rem);
    height: clamp(2.75rem, 6vw, 3rem);
    margin: 0 0 0 auto;
    background-color: var(--primaryDark, var(--primary));
    border: none;
    border-radius: var(--radius-xs, 0.25rem);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  #cs-navigation .cs-active .cs-line1 {
    top: 50%;
    transform: translate(-50%, -50%) rotate(225deg);
  }
  #cs-navigation .cs-active .cs-line2 {
    top: 50%;
    transform: translate(-50%, -50%) translateY(0) rotate(-225deg);
    transform-origin: center;
  }
  #cs-navigation .cs-active .cs-line3 {
    opacity: 0;
    bottom: 100%;
  }
  #cs-navigation .cs-box {
    /* 24px - 28px */
    width: clamp(1.5rem, 2vw, 1.75rem);
    /* 14px - 16px */
    height: clamp(0.875rem, 1.5vw, 1rem);
    position: relative;
  }
  #cs-navigation .cs-line {
    width: 100%;
    height: 2px;
    background-color: var(--buttonPrimaryText, #fff);
    border-radius: var(--radius-pill, 2px);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  #cs-navigation .cs-line1 {
    top: 0;
    transition:
      transform var(--transitionSlow, 0.5s ease),
      top var(--transitionBase, 0.3s ease),
      left var(--transitionBase, 0.3s ease);
    animation-duration: 0.7s;
    animation-timing-function: ease;
    animation-direction: normal;
    animation-fill-mode: forwards;
    transform-origin: center;
  }
  #cs-navigation .cs-line2 {
    top: 50%;
    transform: translateX(-50%) translateY(-50%);
    transition:
      top var(--transitionBase, 0.3s ease),
      left var(--transitionBase, 0.3s ease),
      transform var(--transitionSlow, 0.5s ease);
    animation-duration: 0.7s;
    animation-timing-function: ease;
    animation-direction: normal;
    animation-fill-mode: forwards;
  }
  #cs-navigation .cs-line3 {
    bottom: 0;
    transition:
      bottom var(--transitionBase, 0.3s ease),
      opacity var(--transitionBase, 0.3s ease);
  }
}
/*-- -------------------------- -->
<---   Mobile Navigation Menu   -->
<--- -------------------------- -*/
